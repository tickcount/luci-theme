    {% if (!blank_page): %}
      </div>{# /maincontent #}
    </div>{# /content-card #}
    </div>{# /main-wrapper #}

    <script>
      window.OutlineSidebar = null;
      L.require('sidebar-outline').then(function (m) {
        window.OutlineSidebar = m;
      });
      L.require('menu-outline').then(function () {
        if (window.navigation) L.require('router-outline');
      });
    </script>
    {% endif %}
  </body>
</html>
